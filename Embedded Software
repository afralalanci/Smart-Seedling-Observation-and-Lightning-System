#include <WiFi.h>
#include <ESPAsyncWebServer.h>
#include <HTTPClient.h>
#include <OneWire.h>
#include <DallasTemperature.h>

#define PHOTODIODE_PIN 34
#define HUMIDITY_PIN 4
#define TEMPERATURE_PIN 15

#define RED_LED_PIN 27
#define BLUE_LED_PIN 33
#define WHITE_LED_PIN 32

#define ADC_VREF_mV 3300.0
#define ADC_RESOLUTION 4096.0

const char* ssid = "Cemre Wifi";
const char* password = "a342129D58944";

AsyncWebServer server(80);

unsigned long lastSendTime = 0;
const unsigned long sendInterval = 60000;  // 60 seconds

unsigned long lastReadTime = 0;
const unsigned long readInterval = 1000;   // 1 second


// PWM channel settings
const int pwmFrequency = 5000;
const int pwmResolution = 8;  // 8-bit resolution (0-255)

const int redChannel = 0;
const int blueChannel = 1;
const int whiteChannel = 2;


// DS18B20 temperature sensor
#define ONE_WIRE_BUS TEMPERATURE_PIN

OneWire oneWire(ONE_WIRE_BUS);
DallasTemperature sensors(&oneWire);


// =========================
// SETUP
// =========================

void setup() {

    Serial.begin(115200);
    Serial.println("Setup starting...");


    // Initialize PWM channels
    ledcSetup(redChannel, pwmFrequency, pwmResolution);
    ledcAttachPin(RED_LED_PIN, redChannel);

    ledcSetup(blueChannel, pwmFrequency, pwmResolution);
    ledcAttachPin(BLUE_LED_PIN, blueChannel);

    ledcSetup(whiteChannel, pwmFrequency, pwmResolution);
    ledcAttachPin(WHITE_LED_PIN, whiteChannel);


    // Test hardware
    testLEDs();
    testYL69();
    testPhotodiode();


    // Initialize DS18B20 sensor
    sensors.begin();
    testDS18B20();


    // Connect to WiFi
    Serial.print("Connecting to WiFi...");

    WiFi.begin(ssid, password);

    while (WiFi.status() != WL_CONNECTED) {
        delay(1000);
        Serial.print(".");
    }

    Serial.println(" Connected!");


    // =========================
    // WEB SERVER
    // =========================

    server.on("/", HTTP_GET, [](AsyncWebServerRequest *request) {

        request->send(
            200,
            "text/html",
            "ESP32 Web Server"
        );

    });


    server.on("/setLED", HTTP_POST, [](AsyncWebServerRequest *request) {

        if (request->hasParam("red", true)) {

            int redValue =
                request->getParam("red", true)->value().toInt();

            ledcWrite(redChannel, redValue);

            Serial.printf(
                "Red LED brightness set to %d\n",
                redValue
            );
        }


        if (request->hasParam("blue", true)) {

            int blueValue =
                request->getParam("blue", true)->value().toInt();

            ledcWrite(blueChannel, blueValue);

            Serial.printf(
                "Blue LED brightness set to %d\n",
                blueValue
            );
        }


        if (request->hasParam("white", true)) {

            int whiteValue =
                request->getParam("white", true)->value().toInt();

            ledcWrite(whiteChannel, whiteValue);

            Serial.printf(
                "White LED brightness set to %d\n",
                whiteValue
            );
        }


        request->send(
            200,
            "text/plain",
            "LED values updated"
        );

    });


    server.begin();

    Serial.println("Web server started.");
}


// =========================
// LOOP
// =========================

void loop() {

    unsigned long currentMillis = millis();


    if (currentMillis - lastReadTime >= readInterval) {

        lastReadTime = currentMillis;


        // Read temperature
        float temperature = readTemperature();


        // Read humidity
        float humidity = readHumidity();


        if (isnan(temperature) || isnan(humidity)) {

            Serial.println(
                "Failed to read from sensors!"
            );

        } else {

            Serial.printf(
                "Temperature: %.2f°C, Humidity: %.2f%%\n",
                temperature,
                humidity
            );


            sendData(
                temperature,
                humidity
            );
        }


        // Photodiode reading
        int photoValue =
            analogRead(PHOTODIODE_PIN);

        Serial.printf(
            "Photodiode value: %d\n",
            photoValue
        );
    }
}


// =========================
// TEMPERATURE
// =========================

float readTemperature() {

    sensors.requestTemperatures();

    float tempC =
        sensors.getTempCByIndex(0);

    return tempC;
}


// =========================
// HUMIDITY
// =========================

float readHumidity() {

    int analogValue =
        analogRead(HUMIDITY_PIN);

    float humidity =
        (analogValue / 4095.0) * 100;

    return humidity;
}


// =========================
// SEND DATA TO SERVER
// =========================

void sendData(float temperature, float humidity) {

    unsigned long currentTime = millis();


    if (currentTime - lastSendTime >= sendInterval) {

        lastSendTime = currentTime;


        if (WiFi.status() == WL_CONNECTED) {

            HTTPClient http;


            http.begin(
                "http://your-server-address/upload"
            );


            http.addHeader(
                "Content-Type",
                "application/json"
            );


            String postData =
                "{\"temperature\":" +
                String(temperature) +
                ",\"humidity\":" +
                String(humidity) +
                "}";


            int httpResponseCode =
                http.POST(postData);


            if (httpResponseCode > 0) {

                String response =
                    http.getString();


                Serial.printf(
                    "HTTP Response code: %d\n",
                    httpResponseCode
                );


                Serial.println(
                    "Response from server: " +
                    response
                );

            } else {

                Serial.printf(
                    "Error on sending POST: %d\n",
                    httpResponseCode
                );
            }


            http.end();

        } else {

            Serial.println(
                "WiFi not connected"
            );
        }
    }
}


// =========================
// TEST LEDs
// =========================

void testLEDs() {

    Serial.println(
        "Testing LEDs..."
    );


    // Gradually increase brightness
    for (int i = 0; i <= 255; i++) {

        ledcWrite(redChannel, i);
        ledcWrite(blueChannel, i);
        ledcWrite(whiteChannel, i);

        delay(5);
    }


    // Gradually decrease brightness
    for (int i = 255; i >= 0; i--) {

        ledcWrite(redChannel, i);
        ledcWrite(blueChannel, i);
        ledcWrite(whiteChannel, i);

        delay(5);
    }


    Serial.println(
        "LED test completed."
    );
}


// =========================
// TEST YL69
// =========================

void testYL69() {

    Serial.println(
        "Testing YL69 sensor..."
    );


    float humidity =
        readHumidity();


    if (isnan(humidity)) {

        Serial.println(
            "Failed to read from YL69 sensor!"
        );

    } else {

        Serial.printf(
            "Humidity: %.2f%%\n",
            humidity
        );
    }


    Serial.println(
        "YL69 sensor test completed."
    );
}


// =========================
// TEST DS18B20
// =========================

void testDS18B20() {

    Serial.println(
        "Testing DS18B20 sensor..."
    );


    float temperature =
        readTemperature();


    if (temperature == DEVICE_DISCONNECTED_C) {

        Serial.println(
            "Failed to read from DS18B20 sensor!"
        );

    } else {

        Serial.printf(
            "Temperature: %.2f°C\n",
            temperature
        );
    }


    Serial.println(
        "DS18B20 sensor test completed."
    );
}


// =========================
// TEST PHOTODIODE
// =========================

void testPhotodiode() {

    Serial.println(
        "Testing photodiode..."
    );


    int photoValue =
        analogRead(PHOTODIODE_PIN);


    Serial.printf(
        "Photodiode value: %d\n",
        photoValue
    );


    Serial.println(
        "Photodiode test completed."
    );
}
